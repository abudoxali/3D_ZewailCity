func t(key: String, args: Array = []) -> String:
	var pair: Array = TEXT.get(key, [key, key])
	var value := String(pair[0] if language == "ar" and not String(pair[0]).is_empty() else pair[1])
	return value if args.is_empty() else value % args

func set_language(value: String) -> void:
	language = value if value in ["ar", "en"] else "ar"
	TranslationServer.set_locale(language)
	language_changed.emit()

func direction() -> int:
	return Control.LAYOUT_DIRECTION_RTL if language == "ar" else Control.LAYOUT_DIRECTION_LTR

func source(text: String) -> String:
	return t("source." + text) if TEXT.has("source." + text) else text

func location(id: String, fallback: String = "") -> String:
	return t("location." + id) if TEXT.has("location." + id) else source(fallback)

func tour_name(id: String) -> String:
	return t("tour." + id) if TEXT.has("tour." + id) else t("hud.cinematic")
