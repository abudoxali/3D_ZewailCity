; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Zewail City Campus Explorer"
config/description="Frozen V19 campus production baseline. Architectural dimensions and photographic fidelity remain estimates; see STATUS.md."
config/version="19.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Controls="*res://scripts/controls.gd"
L10n="*res://scripts/ui/l10n.gd"
Settings="*res://scripts/settings.gd"
McpBridgeGame="*res://mcp_bridge_game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/custom_font="res://ui/fonts/NotoSansArabic.ttf"

[internationalization]

locale/include_text_server_data=true
locale/fallback="ar"

[layer_names]

3d_physics/layer_1="world_static"
3d_physics/layer_2="player"
3d_physics/layer_3="dynamic_props"
3d_physics/layer_4="npc"
3d_physics/layer_5="vehicles"
3d_physics/layer_6="interactables"
3d_physics/layer_7="triggers"
3d_physics/layer_8="validation_only"

[physics]

3d/default_gravity=9.81

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.62, 0.72, 0.84, 1)
